{
  "info": {
    "name": "FitTrack API - Workouts (auth on/off)",
    "description": "Run the whole collection in the Collection Runner, in order. The first request logs in and detects whether the API has authentication on, so the same collection is green in both modes (requests that only make sense with auth on are skipped when it is off). Every record the tests create has the note 'postman-test:<runId>' and a random far-future date; cleanup deletes only records with that marker. Set the 'username' and 'password' collection variables (current value, local only) to the demo user from --setup-auth. Never put them in the exported file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const token = pm.collectionVariables.get('token');",
          "const skip = pm.info.requestName.includes('(no token)') || pm.request.headers.has('Authorization');",
          "if (token && !skip) {",
          "    pm.request.headers.add({ key: 'Authorization', value: 'Bearer ' + token });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login (200 with auth on, 404 with auth off)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// New run: new id and new far-future dates, so this run can never collide with real data or an earlier run.",
              "const pad = n => String(n).padStart(2, '0');",
              "const y = 2031 + Math.floor(Math.random() * 68), m = 1 + Math.floor(Math.random() * 12), d = 1 + Math.floor(Math.random() * 27);",
              "pm.collectionVariables.set('runId', Date.now().toString(36) + Math.random().toString(36).slice(2, 6));",
              "pm.collectionVariables.set('runDate', y + '-' + pad(m) + '-' + pad(d));",
              "pm.collectionVariables.set('runDate2', y + '-' + pad(m) + '-' + pad(d + 1));",
              "pm.collectionVariables.set('token', '');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// This request also detects the API's mode, so the rest of the collection adapts and passes in both.",
              "if (pm.response.code === 200) {",
              "    const json = pm.response.json();",
              "    pm.test('Auth ON: login returns a bearer token', () => {",
              "        pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
              "        pm.expect(json.tokenType).to.equal('Bearer');",
              "        pm.expect(json.expiresIn).to.be.above(0);",
              "    });",
              "    pm.collectionVariables.set('authEnabled', 'true');",
              "    pm.collectionVariables.set('token', json.accessToken);",
              "} else {",
              "    pm.test('Auth OFF: login endpoint is not available (404)', () => pm.response.to.have.status(404));",
              "    pm.collectionVariables.set('authEnabled', 'false');",
              "    pm.collectionVariables.set('token', '');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
