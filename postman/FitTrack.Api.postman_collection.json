{
  "info": {
    "name": "FitTrack API - Workouts",
    "description": "Part 1 test collection. Uses the dates 2030-01-15 and 2030-01-16 and deletes everything it creates, so it passes repeatedly in the Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST create workout (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Remove leftovers from an earlier failed run so the collection can be run repeatedly.",
              "const base = pm.collectionVariables.get('baseUrl');",
              "pm.sendRequest({ url: base + '/api/workouts', method: 'GET' }, (err, res) => {",
              "    if (err || res.code !== 200) { return; }",
              "    res.json().filter(w => w.date === '2030-01-15').forEach(w => {",
              "        pm.sendRequest({ url: base + '/api/workouts/' + w.id, method: 'DELETE' }, () => {});",
              "    });",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('Location header points at the new workout', () => {",
              "    pm.response.to.have.header('Location');",
              "    pm.expect(pm.response.headers.get('Location')).to.match(new RegExp('/api/workouts/' + json.id + '$'));",
              "});",
              "pm.test('Server assigned id and createdUtc (client over-posting ignored)', () => {",
              "    pm.expect(json.id).to.not.equal(999);",
              "    pm.expect(json.createdUtc).to.not.include('2000-01-01');",
              "    pm.expect(json.createdUtc).to.be.a('string').and.not.empty;",
              "});",
              "pm.test('Response has the fields that were sent', () => {",
              "    pm.expect(json.type).to.equal('Running');",
              "    pm.expect(json.durationMinutes).to.equal(30);",
              "});",
              "pm.collectionVariables.set('workoutId', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/workouts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "workouts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"2030-01-15\",\n  \"type\": \"Running\",\n  \"durationMinutes\": 30,\n  \"caloriesBurned\": 300,\n  \"intensity\": \"Moderate\",\n  \"notes\": \"Postman test\",\n  \"id\": 999,\n  \"createdUtc\": \"2000-01-01T00:00:00Z\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
