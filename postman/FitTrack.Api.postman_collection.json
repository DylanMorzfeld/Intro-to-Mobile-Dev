    {
      "name": "POST create workout (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Delete leftovers from earlier FAILED runs. Only records whose notes start with 'postman-test:' are touched;",
              "// anything else in the database (real workouts) is never deleted.",
              "const base = pm.collectionVariables.get('baseUrl');",
              "const token = pm.collectionVariables.get('token');",
              "pm.sendRequest({ url: base + '/api/workouts', method: 'GET' }, (err, res) => {",
              "    if (err || res.code !== 200) { return; }",
              "    res.json().filter(w => (w.notes || '').startsWith('postman-test:')).forEach(w => {",
              "        const header = token ? { Authorization: 'Bearer ' + token } : {};",
              "        pm.sendRequest({ url: base + '/api/workouts/' + w.id, method: 'DELETE', header }, () => {});",
              "    });",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('Location header points at the new workout', () => {",
              "    pm.response.to.have.header('Location');",
              "    pm.expect(pm.response.headers.get('Location')).to.match(new RegExp('/api/workouts/' + json.id + '$'));",
              "});",
              "pm.test('Server assigned id and createdUtc (client over-posting ignored)', () => {",
              "    pm.expect(json.id).to.not.equal(999);",
              "    pm.expect(json.createdUtc).to.not.include('2000-01-01');",
              "    pm.expect(json.createdUtc).to.be.a('string').and.not.empty;",
              "});",
              "pm.test('Response has the fields that were sent', () => {",
              "    pm.expect(json.type).to.equal('Running');",
              "    pm.expect(json.durationMinutes).to.equal(30);",
              "    pm.expect(json.isCompleted).to.equal(false);",
              "});",
              "pm.collectionVariables.set('workoutId', json.id);"
            ]
          }
        }
      ],
