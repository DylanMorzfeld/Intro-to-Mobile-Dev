<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FitTrack"
             xmlns:converters="clr-namespace:FitTrack.Converters"
             x:Class="FitTrack.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:CalorieProgressConverter x:Key="CalorieProgressConverter"/>
            <converters:GoalProgressConverter x:Key="GoalProgressConverter" />
            <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
            <converters:GoalCompletedConverter x:Key="GoalCompletedConverter" />
            <converters:CompleteSwipeTextConverter x:Key="CompleteSwipeTextConverter" />
            <converters:CompletionStyleConverter x:Key="CompletionStyleConverter" />
            
        </ResourceDictionary>
    </Application.Resources>
</Application>