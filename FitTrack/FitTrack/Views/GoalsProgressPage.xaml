<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitTrack.ViewModels"
             xmlns:models="clr-namespace:FitTrack.Models"
             xmlns:views="clr-namespace:FitTrack.Views"
             x:Class="FitTrack.Views.GoalsProgressPage"
             x:DataType="vm:GoalsViewModel"
             Title="Goals">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Recent activity, fed by the app's custom events (WorkoutLoggedMessage and
             NutritionalDetailsRequestedMessage) via ActivityFeedService. -->
        <Border Grid.Row="0" Margin="12,12,12,4" Padding="14" StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="4">
                <Label Text="Recent Activity" FontAttributes="Bold" FontSize="16" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentActivity}" Spacing="2">
                    <BindableLayout.EmptyView>
                        <Label Text="Complete a workout or view a meal's nutrition to see activity here."
                               FontSize="12"
                               TextColor="Gray" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Label Text="{Binding .}" FontSize="12" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadGoalsCommand}">

            <CollectionView ItemsSource="{Binding Goals}"
                             SelectionMode="None"
                             EmptyView="No goals yet. Tap the button below to set your first one!">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FitnessGoal">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Delete"
                                               BackgroundColor="{StaticResource DangerColor}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type views:GoalsProgressPage}}, Path=BindingContext.DeleteGoalCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border Margin="12,6" Padding="16" StrokeShape="RoundRectangle 12">
                                <VerticalStackLayout Spacing="8">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type views:GoalsProgressPage}}, Path=BindingContext.SelectGoalCommand}"
                                            CommandParameter="{Binding .}" />
                                    </VerticalStackLayout.GestureRecognizers>

                                    <Label Text="{Binding Description}" FontAttributes="Bold" FontSize="16" />
                                    <Label Text="{Binding GoalType}" FontSize="12" TextColor="Gray" />

                                    <ProgressBar Progress="{Binding ., Converter={StaticResource GoalProgressConverter}}"
                                                 ProgressColor="{Binding ., Converter={StaticResource GoalProgressColorConverter}}" />

                                    <Label Text="🏆 Goal achieved! Great work."
                                           TextColor="{StaticResource SuccessColor}"
                                           FontAttributes="Bold"
                                           FontSize="13"
                                           IsVisible="{Binding ., Converter={StaticResource GoalCompletedConverter}}" />

                                    <Label FontSize="12">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding CurrentValue}" />
                                                <Span Text=" / " />
                                                <Span Text="{Binding TargetValue}" />
                                                <Span Text=" " />
                                                <Span Text="{Binding Unit}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="2"
                Text="+ Set New Goal"
                Command="{Binding AddGoalCommand}"
                Margin="16"
                CornerRadius="24"
                HeightRequest="48" />

    </Grid>
</ContentPage>