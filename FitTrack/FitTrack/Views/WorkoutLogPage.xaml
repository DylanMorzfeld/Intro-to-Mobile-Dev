<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitTrack.ViewModels"
             xmlns:models="clr-namespace:FitTrack.Models"
             xmlns:views="clr-namespace:FitTrack.Views"
             x:Class="FitTrack.Views.WorkoutLogPage"
             x:DataType="vm:WorkoutLogViewModel"
             Title="Workout Log">

    <Grid RowDefinitions="*, Auto">

        <RefreshView Grid.Row="0"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadWorkoutsCommand}">

            <CollectionView ItemsSource="{Binding Workouts}"
                             SelectionMode="None"
                             EmptyView="No workouts logged yet. Tap the button below to log your first one!">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Workout">
                        <SwipeView>
                            <!-- Swiping RIGHT reveals these (LeftItems): mark complete or edit details. -->
                            <SwipeView.LeftItems>
                                <SwipeItems>
                                    <SwipeItem Text="{Binding IsCompleted, Converter={StaticResource CompleteSwipeTextConverter}}"
                                               BackgroundColor="{StaticResource SuccessColor}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type views:WorkoutLogPage}}, Path=BindingContext.ToggleCompleteCommand}"
                                               CommandParameter="{Binding .}" />
                                    <SwipeItem Text="Edit"
                                               BackgroundColor="{StaticResource ActionColor}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type views:WorkoutLogPage}}, Path=BindingContext.SelectWorkoutCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.LeftItems>

                            <!-- Swiping LEFT reveals these (RightItems): delete the workout. -->
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Delete"
                                               BackgroundColor="{StaticResource DangerColor}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type views:WorkoutLogPage}}, Path=BindingContext.DeleteWorkoutCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <!-- BackgroundColor and the ActivityType label's Opacity both derive
                                 from the same IsCompleted flag via one shared converter
                                 (CompletionStyleConverter), distinguished by ConverterParameter. -->
                            <Grid Padding="16,12"
                                  ColumnDefinitions="Auto,*,Auto"
                                  BackgroundColor="{Binding IsCompleted, Converter={StaticResource CompletionStyleConverter}, ConverterParameter=Background}">

                                <Label Grid.Column="0"
                                       Text="{Binding ActivityType}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       WidthRequest="100"
                                       Opacity="{Binding IsCompleted, Converter={StaticResource CompletionStyleConverter}, ConverterParameter=Opacity}" />

                                <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                                    <Label Text="{Binding DateLogged, StringFormat='{0:MMM d, yyyy}'}"
                                           FontSize="12"
                                           TextColor="Gray" />
                                    <Label Text="{Binding DurationMinutes, StringFormat='{0} minutes'}"
                                           FontSize="12" />
                                </VerticalStackLayout>

                                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                                    <Label Text="✓"
                                           TextColor="MediumSeaGreen"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           IsVisible="{Binding IsCompleted}"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding CaloriesBurned, StringFormat='{0} cal'}"
                                           VerticalOptions="Center"
                                           FontAttributes="Bold" />
                                </HorizontalStackLayout>

                            </Grid>

                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <VerticalStackLayout Grid.Row="1">
            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource DangerColor}"
                   Margin="16,8,16,0"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
            <Button Text="+ Log Workout"
                    Command="{Binding AddWorkoutCommand}"
                    Margin="16"
                    CornerRadius="24"
                    HeightRequest="48" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>