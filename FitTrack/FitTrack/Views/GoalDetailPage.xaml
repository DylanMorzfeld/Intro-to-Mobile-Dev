<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitTrack.ViewModels"
             x:Class="FitTrack.Views.GoalDetailPage"
             x:DataType="vm:GoalDetailViewModel"
             Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Goal Type" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding GoalTypes}"
                    SelectedItem="{Binding SelectedGoalType}" />

            <Label Text="Description" FontAttributes="Bold" />
            <Entry Text="{Binding Description}" Placeholder="e.g. Lose 10 lbs before spring break" />

            <Label Text="Unit (e.g. lbs, miles, minutes)" FontAttributes="Bold" />
            <Entry Text="{Binding Unit}" Placeholder="lbs" />

            <Label Text="Starting Value" FontAttributes="Bold" />
            <Entry Text="{Binding StartValue}" Keyboard="Numeric" />

            <Label Text="Current Value" FontAttributes="Bold" />
            <Entry Text="{Binding CurrentValue}" Keyboard="Numeric" />

            <Label Text="Target Value" FontAttributes="Bold" />
            <Entry Text="{Binding TargetValue}" Keyboard="Numeric" />

            <Label Text="Start Date" FontAttributes="Bold" />
            <DatePicker Date="{Binding StartDate}" />

            <Label Text="Target Date" FontAttributes="Bold" />
            <DatePicker Date="{Binding TargetDate}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,16,0,0">
                <Button Grid.Column="0"
                        Text="Cancel"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="LightGray"
                        TextColor="Black" />

                <Button Grid.Column="1"
                        Text="Save"
                        Command="{Binding SaveCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>