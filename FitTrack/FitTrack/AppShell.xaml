<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FitTrack.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FitTrack"
    xmlns:views="clr-namespace:FitTrack.Views"
    Title="FitTrack">

    <TabBar>
        <ShellContent Title="Workouts"
                      Icon="dotnet_bot.png"
                      ContentTemplate="{DataTemplate views:WorkoutLogPage}"
                      Route="WorkoutLogPage" />

        <ShellContent Title="Diet"
                      Icon="dotnet_bot.png"
                      ContentTemplate="{DataTemplate views:DietTrackerPage}"
                      Route="DietTrackerPage" />

        <ShellContent Title="Goals"
                      Icon="dotnet_bot.png"
                      ContentTemplate="{DataTemplate views:GoalsProgressPage}"
                      Route="GoalsProgressPage" />
    </TabBar>

</Shell>